<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Student Management System</h1>
    <nav><a href="/">Students</a><a href="/students/add">Add Student</a></nav>
  </header>

  <div class="container">
    <div class="toolbar">
      <form action="/students/search" method="GET">
        <input type="text" name="keyword" placeholder="Search student...">
        <button class="btn" type="submit">Search</button>
      </form>
      <a class="btn" href="/students/add">Add Student</a>
    </div>

    <div class="table-wrap">
      <table>
        <tr>
          <th>ID</th><th>Student ID</th><th>Name</th>
          <th>Course</th><th>Year</th><th>Email</th><th>Actions</th>
        </tr>
        <% students.forEach(student => { %>
        <tr>
          <td><%= student.id %></td>
          <td><%= student.student_id %></td>
          <td><%= student.first_name %> <%= student.last_name %></td>
          <td><%= student.course %></td>
          <td><%= student.year_level %></td>
          <td><%= student.email %></td>
          <td>
            <a class="btn btn-gray" href="/students/edit/<%= student.id %>">Edit</a>
            <form action="/students/delete/<%= student.id %>" method="POST"
                  style="display:inline"
                  onsubmit="return confirm('Delete this student?')">
              <button class="btn btn-danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </table>
    </div>
  </div>
</body>
</html>